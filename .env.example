# Database Configuration
# DB_PASSWORD has no default in docker-compose.yml -- it must be set.
DATABASE_URL=postgresql+asyncpg://eve_user:your_password@localhost:5432/eve_markets
DB_PASSWORD=your_password
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Redis Configuration (REDIS_PASSWORD is required by docker-compose.yml)
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=your_redis_password
ESI_CACHE_ENABLED=True

# ESI API Configuration
ESI_BASE_URL=https://esi.evetech.net/latest
ESI_DATASOURCE=tranquility
ESI_RATE_LIMIT=100
ESI_RATE_PERIOD=60
ESI_MAX_RETRIES=4
ESI_ERROR_LIMIT_FLOOR=20
# CCP asks third-party apps to identify themselves and provide contact info
ESI_USER_AGENT=eve-discovery/0.1 (market analytics; +https://github.com/TargetedEntropy/eve-discovery)

# Application Configuration
LOG_LEVEL=INFO
DEBUG=False

# Collection scope (comma separated region ids)
# 10000002 The Forge (Jita), 10000043 Domain (Amarr), 10000032 Sinq Laison (Dodixie)
COLLECTION_REGION_IDS=10000002

# Model Configuration
# Checkpoints are stored per item as model_{type_id}_{region_id}.pth in this directory
MODEL_DIR=data/models
LOOKBACK_WINDOW=30
PREDICTION_HORIZON_DAYS=30

# API Configuration
API_CORS_ORIGINS=http://localhost:8050
API_CORS_ALLOW_CREDENTIALS=False

# Dashboard Configuration
DASHBOARD_DEBUG=False
DASHBOARD_REFRESH_SECONDS=900

# MLflow Configuration (inside docker-compose use http://mlflow:5000)
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=eve-price-prediction
MLFLOW_REGISTERED_MODEL_PREFIX=eve-price

# Scheduler Configuration (hours are UTC)
# RETRAINING_DAY accepts mon/tue/wed/thu/fri/sat/sun, full day names, or 0-6
COLLECTION_INTERVAL_MINUTES=5
FEATURE_COMPUTATION_INTERVAL_HOURS=1
HISTORY_COLLECTION_HOUR=1
PREDICTION_HOUR=3
DRIFT_CHECK_HOUR=4
RETRAINING_DAY=sun
RETRAINING_HOUR=2
RETRAIN_ON_DRIFT=True

# Monitoring
DRIFT_THRESHOLD=0.5
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...

# Retention (TimescaleDB policies on order_snapshots)
ORDER_SNAPSHOT_RETENTION_DAYS=30
ORDER_SNAPSHOT_COMPRESS_AFTER_DAYS=2
